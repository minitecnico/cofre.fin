VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Domínio onde a função serverless do assistente está publicada.
# Na web deixe VAZIO (a chamada é same-origin e o caminho relativo basta).
# Para gerar o APK é OBRIGATÓRIO preencher — dentro do app a origem é
# https://localhost, onde /api/ai-chat não existe. Sem barra no final.
VITE_API_BASE_URL=

# Variáveis privadas usadas pela função serverless do assistente financeiro.
NINEROUTER_API_KEY=sua-chave-privada-do-9router
NINEROUTER_BASE_URL=https://9router.com/v1
NINEROUTER_MODEL=free-combo

# Web Push (aviso de pagamento com o app fechado) — usadas por /api/push-notify.
# A chave PÚBLICA já está no código (constants/index.js). A PRIVADA é segredo:
# só na Vercel. SERVICE_ROLE ignora o RLS — nunca prefixe com VITE_.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
