VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Domínio publicado do app (ex.: https://seu-app.vercel.app), sem barra no final.
# Na web deixe VAZIO. Para gerar o APK é OBRIGATÓRIO: dentro do app a origem é
# https://localhost, e os links compartilhados (PIX, extrato, relatório) precisam
# apontar pro domínio real.
VITE_API_BASE_URL=

# Web Push (aviso de pagamento com o app fechado) — usadas por /api/push-notify.
# A chave PÚBLICA já está no código (constants/index.js). A PRIVADA é segredo:
# só na Vercel. SERVICE_ROLE ignora o RLS — nunca prefixe com VITE_.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
